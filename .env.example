# Sao chép thành .env cho máy phát triển. Không ghi giá trị thật của môi trường thử nghiệm, môi trường thật.
DATABASE_URL=postgres://vcomm_ung_dung:mat_khau_phat_trien@localhost:5432/vcomm
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PLATFORM_PORT=3000
ACCESS_TOKEN_SECRET=thay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
# Mã ứng dụng Google, Microsoft, Zalo và khóa eSMS nhập ở màn hình Cài đặt tích hợp (THAY_DOI_08), không đặt ở đây.
# Máy phát triển: email ghi ra log, không gửi thật.
EMAIL_DRIVER=log
# Địa chỉ giao diện web, dùng để tạo đường dẫn kích hoạt trong email, SMS.
WEB_ORIGIN=http://localhost:3000
# Nguồn bản web của ứng dụng di động được gọi API (CONG_VIEC_22), phân tách bằng dấu phẩy; để trống trên môi trường thật nếu không dùng.
APP_WEB_ORIGINS=http://localhost:8083,http://localhost:8084
# Khóa mã hóa bí mật xác thực hai lớp và khóa trong Cài đặt tích hợp (ít nhất 32 ký tự).
MFA_SECRET_KEY=
# Tác vụ nền (BullMQ trên Redis); đặt disabled để tắt.
BACKGROUND_JOBS=enabled
# Lưu tệp đính kèm: local (thư mục STORAGE_DIRECTORY, mặc định .storage) hoặc s3 (cần S3_BUCKET, AWS_REGION và quyền IAM).
STORAGE_DRIVER=local
STORAGE_DIRECTORY=
S3_BUCKET=
AWS_REGION=ap-southeast-1
# Kết nối GHN (CONG_VIEC_24): token, mã cửa hàng của tài khoản GHN; khóa webhook ít nhất 24 ký tự ngẫu nhiên, gắn vào đường dẫn webhook khai báo với GHN.
# GHN_BASE_URL để trống là môi trường thử nghiệm của GHN; môi trường thật: https://online-gateway.ghn.vn
GHN_API_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_KEY=
GHN_BASE_URL=
# Kết nối GHTK (CONG_VIEC_31): token API và mã đối tác (X-Client-Source) của tài khoản GHTK; khóa webhook ít nhất 24 ký tự ngẫu nhiên, gắn vào đường dẫn /public/carriers/ghtk/webhook/{khóa} khai báo với GHTK.
# Địa chỉ lấy hàng: tên, số điện thoại, địa chỉ, tỉnh, xã của kho xuất; mã địa chỉ lấy hàng trên GHTK không bắt buộc.
# GHTK_BASE_URL để trống là môi trường thử nghiệm của GHTK; môi trường thật: https://services.giaohangtietkiem.vn
GHTK_API_TOKEN=
GHTK_CLIENT_SOURCE=
GHTK_WEBHOOK_KEY=
GHTK_BASE_URL=
GHTK_PICK_ADDRESS_ID=
GHTK_PICK_NAME=
GHTK_PICK_TEL=
GHTK_PICK_ADDRESS=
GHTK_PICK_PROVINCE=
GHTK_PICK_WARD=
# Kết nối Viettel Post (CONG_VIEC_29): token dài hạn (hạn 1 năm, lấy qua API ownerconnect hoặc trang viettelpost.vn), mã dịch vụ theo hợp đồng (ví dụ VCN);
# khóa webhook ít nhất 24 ký tự ngẫu nhiên, gắn vào đường dẫn webhook và khai báo làm TOKEN webhook với Viettel Post; người gửi là nơi lấy hàng.
# VIETTEL_POST_BASE_URL để trống là môi trường thử nghiệm của Viettel Post; môi trường thật: https://partner.viettelpost.vn
VIETTEL_POST_TOKEN=
VIETTEL_POST_SERVICE_CODE=
VIETTEL_POST_WEBHOOK_KEY=
VIETTEL_POST_SENDER_NAME=
VIETTEL_POST_SENDER_PHONE=
VIETTEL_POST_SENDER_ADDRESS=
VIETTEL_POST_BASE_URL=
# Kết nối VNPost, hệ thống MyVNPost (CONG_VIEC_28): tên đăng nhập, mật khẩu, mã khách hàng (CMS) của tài khoản my.vnpost.vn; mã hợp đồng nếu có;
# mã dịch vụ chuyển phát do VNPost cấp (ví dụ ETN011); khóa webhook ít nhất 24 ký tự ngẫu nhiên, gắn vào đường dẫn webhook khai báo với VNPost.
# Người gửi: tỉnh, xã ghi theo tên (ví dụ "Thành phố Hồ Chí Minh", "Phường Sài Gòn"), hệ thống tra mã trong danh mục của VNPost.
# VNPOST_BASE_URL để trống là môi trường thử nghiệm của VNPost; môi trường thật: https://connect-my.vnpost.vn
VNPOST_USERNAME=
VNPOST_PASSWORD=
VNPOST_CUSTOMER_CODE=
VNPOST_CONTRACT_CODE=
VNPOST_SERVICE_CODE=
VNPOST_WEBHOOK_KEY=
VNPOST_SENDER_NAME=
VNPOST_SENDER_PHONE=
VNPOST_SENDER_ADDRESS=
VNPOST_SENDER_PROVINCE=
VNPOST_SENDER_WARD=
VNPOST_BASE_URL=
# Kết nối J&T Express (CONG_VIEC_30): apiAccount, privateKey xem ở J&T Open Platform (Bảng điều khiển, Trang cá nhân);
# mã khách hàng, mật khẩu gốc do bưu cục J&T cấp; khóa webhook ít nhất 24 ký tự ngẫu nhiên, gắn vào đường dẫn khai báo với J&T.
# JT_BASE_URL để trống là môi trường thử nghiệm của J&T; môi trường thật: https://ylopenapi.jtexpress.vn
# Điểm lấy hàng: tên tỉnh, phường/xã theo đơn vị hành chính hai cấp.
JT_API_ACCOUNT=
JT_PRIVATE_KEY=
JT_CUSTOMER_CODE=
JT_CUSTOMER_PASSWORD=
JT_WEBHOOK_KEY=
JT_BASE_URL=
JT_SENDER_NAME=
JT_SENDER_PHONE=
JT_SENDER_PROVINCE=
JT_SENDER_WARD=
JT_SENDER_ADDRESS=
# Cổng thanh toán VNPAY (CONG_VIEC_25); trống thì không bật được phương thức VNPAY. VNPAY_RETURN_URL là địa chỉ công khai của API + /api/v1/public/payments/vnpay/return.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=
VNPAY_RETURN_URL=
# Cổng thanh toán MoMo (CONG_VIEC_33); thiếu MOMO_PARTNER_CODE, MOMO_ACCESS_KEY, MOMO_SECRET_KEY, MOMO_IPN_URL, MOMO_RETURN_URL thì không bật được phương thức MoMo.
# MOMO_IPN_URL là địa chỉ công khai của API + /api/v1/public/payments/momo/notify; MOMO_RETURN_URL là địa chỉ công khai của API + /api/v1/public/payments/momo/return.
# MOMO_ENDPOINT để trống là môi trường thử nghiệm https://test-payment.momo.vn; môi trường thật: https://payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_IPN_URL=
MOMO_RETURN_URL=
# Cổng SePay (CONG_VIEC_34): chuyển khoản theo mã VietQR, SePay gửi webhook về địa chỉ công khai của API + /api/v1/public/payments/sepay/notify,
# kiểu chứng thực API Key (tiêu đề Authorization: Apikey <khóa>). SEPAY_BANK_CODE theo https://qr.sepay.vn/banks.json (ví dụ MBBank). Thiếu một biến thì không bật được.
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Cổng thanh toán PayOS (CONG_VIEC_35): Client ID, API Key, Checksum Key của kênh thanh toán trên my.payos.vn; trống thì không bật được phương thức PayOS.
# PAYOS_RETURN_URL là địa chỉ công khai của API + /api/v1/public/payments/payos/return; webhook đăng ký trên PayOS là địa chỉ công khai của API + /api/v1/public/payments/payos/notify.
# PAYOS_BANK_NAME: tên ngân hàng của tài khoản nhận tiền hiện cho người mua (PayOS chỉ trả mã BIN). PAYOS_API_URL trống thì dùng https://api-merchant.payos.vn.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_BANK_NAME=
PAYOS_API_URL=
# Chuyển khoản ngân hàng và VietQR (CONG_VIEC_36): tài khoản nhận tiền của công ty vận hành sàn; trống thì không bật được phương thức chuyển khoản.
# BANK_TRANSFER_BANK_BIN là mã ngân hàng 6 số theo NAPAS; số tài khoản phải trùng số tài khoản của quỹ ngân hàng đã kết nối đối soát để tự ghép tiền về.
BANK_TRANSFER_BANK_BIN=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
# Cổng BIDV thu hộ qua tài khoản định danh (CONG_VIEC_37); trống thì không bật được phương thức BIDV. Đăng ký với BIDV đường dẫn gốc
# <địa chỉ công khai của API>/api/v1/public/payments/bidv (BIDV gọi /getbill, /paybill). BIDV_VA_PREFIX tối đa 7 ký tự chữ, số.
# BIDV_ALLOWED_IPS: các địa chỉ IP của BIDV, cách nhau dấu phẩy; trống thì không giới hạn.
BIDV_SERVICE_ID=
BIDV_VA_PREFIX=
BIDV_ACCOUNT_NAME=
BIDV_CHECKSUM_SECRET=
BIDV_ALLOWED_IPS=
# Cổng thanh toán Ecopay của Finviet (CONG_VIEC_38); trống thì không bật được phương thức Ecopay. ECOPAY_API_URL trống là môi trường thử nghiệm https://mgw-test.finviet.com.vn:6868, môi trường thật https://mgw.finviet.com.vn:6868.
# ECOPAY_RETURN_URL là địa chỉ công khai của API + /api/v1/public/payments/ecopay/return; đường dẫn nhận kết quả đăng ký với Finviet: + /api/v1/public/payments/ecopay/notify.
ECOPAY_MERCHANT_CODE=
ECOPAY_SECRET_KEY=
ECOPAY_STORE_CODE=
ECOPAY_TERMINAL_CODE=
ECOPAY_API_URL=
ECOPAY_RETURN_URL=
# Cổng thanh toán G-Pay (CONG_VIEC_39); trống thì không bật được phương thức G-Pay. Thông tin lấy trên trang nhà phát triển G-Pay.
# GPAY_API_URL trống thì dùng môi trường thử nghiệm https://openapi.sandbox.g-pay.vn/v1. Khóa, chứng thư dạng PEM, viết một dòng thì thay xuống dòng bằng \n.
# GPAY_MERCHANT_PRIVATE_KEY: khóa riêng của VComm; GPAY_MERCHANT_CERTIFICATE: chứng thư công khai đã gửi G-Pay; GPAY_PUBLIC_KEY: khóa (hoặc chứng thư) công khai của G-Pay.
# GPAY_WEBHOOK_URL, GPAY_RETURN_URL: địa chỉ công khai của API + /api/v1/public/payments/gpay/notify và /api/v1/public/payments/gpay/return.
GPAY_API_URL=
GPAY_CLIENT_ID=
GPAY_CLIENT_SECRET=
GPAY_MERCHANT_PRIVATE_KEY=
GPAY_MERCHANT_CERTIFICATE=
GPAY_PUBLIC_KEY=
GPAY_WEBHOOK_URL=
GPAY_RETURN_URL=
# ZaloPay (CONG_VIEC_42 cổng zalopay; cùng bộ biến với CONG_VIEC_41 Apple Pay qua ZaloPay, một tài khoản ZaloPay cho mọi phương thức đi qua ZaloPay); trống thì không bật được phương thức ZaloPay.
# ZALOPAY_KEY1 ký yêu cầu gửi ZaloPay, ZALOPAY_KEY2 kiểm kết quả gửi về; ZALOPAY_ENDPOINT trống là môi trường thử nghiệm https://sb-openapi.zalopay.vn (chạy thật: https://openapi.zalopay.vn).
# ZALOPAY_PUBLIC_API_URL là địa chỉ công khai của API (không kèm /api/v1); kết quả gửi về /api/v1/public/payments/<mã cổng>/notify, trang trả về /api/v1/public/payments/<mã cổng>/return.
# ZaloPay (CONG_VIEC_41 Apple Pay qua trang thanh toán ZaloPay; dùng chung cho các phương thức khác đi qua ZaloPay); trống thì không bật được phương thức Apple Pay.
# ZALOPAY_KEY1 ký yêu cầu tạo đơn, ZALOPAY_KEY2 kiểm kết quả gửi về; ZALOPAY_ENDPOINT trống là môi trường thử nghiệm https://sb-openapi.zalopay.vn.
# ZALOPAY_PUBLIC_API_URL là địa chỉ công khai của API (không kèm /api/v1). ZALOPAY_APPLE_PAY_PREFERRED_METHODS: giá trị preferred_payment_method ZaloPay cấp để mở thẳng Apple Pay (cách nhau dấu phẩy), trống thì hiện mọi phương thức.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=
ZALOPAY_PUBLIC_API_URL=
# Google Pay qua trang thanh toán ZaloPay (CONG_VIEC_40) dùng bộ ZALOPAY_* ở trên. ZALOPAY_GOOGLE_PAY_PREFERRED_METHODS: preferred_payment_method (cách nhau dấu phẩy), trống là international_card.
ZALOPAY_GOOGLE_PAY_PREFERRED_METHODS=
ZALOPAY_APPLE_PAY_PREFERRED_METHODS=
