# Sao chép thành .env cho máy phát triển. Không ghi giá trị thật của môi trường thử nghiệm, môi trường thật.
DATABASE_URL=postgres://vcomm_ung_dung:mat_khau_phat_trien@localhost:5432/vcomm
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PLATFORM_PORT=3000
ACCESS_TOKEN_SECRET=thay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
# Mã ứng dụng Google, Microsoft, Zalo và khóa eSMS nhập ở màn hình Cài đặt tích hợp (THAY_DOI_08), không đặt ở đây.
# Máy phát triển: email ghi ra log, không gửi thật.
EMAIL_DRIVER=log
# Địa chỉ giao diện web, dùng để tạo đường dẫn kích hoạt trong email, SMS.
WEB_ORIGIN=http://localhost:3000
# Nguồn bản web của ứng dụng di động được gọi API (CONG_VIEC_22), phân tách bằng dấu phẩy; để trống trên môi trường thật nếu không dùng.
APP_WEB_ORIGINS=http://localhost:8083
# Khóa mã hóa bí mật xác thực hai lớp và khóa trong Cài đặt tích hợp (ít nhất 32 ký tự).
MFA_SECRET_KEY=
# Tác vụ nền (BullMQ trên Redis); đặt disabled để tắt.
BACKGROUND_JOBS=enabled
# Lưu tệp đính kèm: local (thư mục STORAGE_DIRECTORY, mặc định .storage) hoặc s3 (cần S3_BUCKET, AWS_REGION và quyền IAM).
STORAGE_DRIVER=local
STORAGE_DIRECTORY=
S3_BUCKET=
AWS_REGION=ap-southeast-1
# Kết nối GHN (CONG_VIEC_24): token, mã cửa hàng của tài khoản GHN; khóa webhook ít nhất 24 ký tự ngẫu nhiên, gắn vào đường dẫn webhook khai báo với GHN.
# GHN_BASE_URL để trống là môi trường thử nghiệm của GHN; môi trường thật: https://online-gateway.ghn.vn
GHN_API_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_KEY=
GHN_BASE_URL=
# Cổng thanh toán VNPAY (CONG_VIEC_25); trống thì không bật được phương thức VNPAY. VNPAY_RETURN_URL là địa chỉ công khai của API + /api/v1/public/payments/vnpay/return.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=
VNPAY_RETURN_URL=
# Cổng thanh toán MoMo (CONG_VIEC_33); thiếu MOMO_PARTNER_CODE, MOMO_ACCESS_KEY, MOMO_SECRET_KEY, MOMO_IPN_URL, MOMO_RETURN_URL thì không bật được phương thức MoMo.
# MOMO_IPN_URL là địa chỉ công khai của API + /api/v1/public/payments/momo/notify; MOMO_RETURN_URL là địa chỉ công khai của API + /api/v1/public/payments/momo/return.
# MOMO_ENDPOINT để trống là môi trường thử nghiệm https://test-payment.momo.vn; môi trường thật: https://payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_IPN_URL=
MOMO_RETURN_URL=
# ZaloPay (CONG_VIEC_41 Apple Pay qua trang thanh toán ZaloPay; dùng chung cho các phương thức khác đi qua ZaloPay); trống thì không bật được phương thức Apple Pay.
# ZALOPAY_KEY1 ký yêu cầu tạo đơn, ZALOPAY_KEY2 kiểm kết quả gửi về; ZALOPAY_ENDPOINT trống là môi trường thử nghiệm https://sb-openapi.zalopay.vn.
# ZALOPAY_PUBLIC_API_URL là địa chỉ công khai của API (không kèm /api/v1). ZALOPAY_APPLE_PAY_PREFERRED_METHODS: giá trị preferred_payment_method ZaloPay cấp để mở thẳng Apple Pay (cách nhau dấu phẩy), trống thì hiện mọi phương thức.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=
ZALOPAY_PUBLIC_API_URL=
ZALOPAY_APPLE_PAY_PREFERRED_METHODS=
