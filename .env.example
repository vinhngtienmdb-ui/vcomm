# Sao chép thành .env cho máy phát triển. Không ghi giá trị thật của môi trường thử nghiệm, môi trường thật.
DATABASE_URL=postgres://vcomm_ung_dung:mat_khau_phat_trien@localhost:5432/vcomm
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PLATFORM_PORT=3000
ACCESS_TOKEN_SECRET=thay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=
# Máy phát triển: email, SMS ghi ra log, không gửi thật.
EMAIL_DRIVER=log
SMS_DRIVER=log
# Địa chỉ giao diện web, dùng để tạo đường dẫn kích hoạt trong email, SMS.
WEB_ORIGIN=http://localhost:3000
# Lát L4: email, SMS chỉ ghi ra log.
EMAIL_DRIVER=log
# Khóa mã hóa bí mật xác thực hai lớp (ít nhất 32 ký tự); môi trường thật dùng AWS KMS.
