# Sao chép thành .env cho máy phát triển. Không ghi giá trị thật của môi trường thử nghiệm, môi trường thật.
DATABASE_URL=postgres://vcomm_ung_dung:mat_khau_phat_trien@localhost:5432/vcomm
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PLATFORM_PORT=3000
ACCESS_TOKEN_SECRET=thay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
# Mã ứng dụng Google, Microsoft, Zalo và khóa eSMS nhập ở màn hình Cài đặt tích hợp (THAY_DOI_08), không đặt ở đây.
# Máy phát triển: email ghi ra log, không gửi thật.
EMAIL_DRIVER=log
# Địa chỉ giao diện web, dùng để tạo đường dẫn kích hoạt trong email, SMS.
WEB_ORIGIN=http://localhost:3000
# Nguồn bản web của ứng dụng di động được gọi API (CONG_VIEC_22), phân tách bằng dấu phẩy; để trống trên môi trường thật nếu không dùng.
APP_WEB_ORIGINS=http://localhost:8083
# Khóa mã hóa bí mật xác thực hai lớp và khóa trong Cài đặt tích hợp (ít nhất 32 ký tự).
MFA_SECRET_KEY=
# Tác vụ nền (BullMQ trên Redis); đặt disabled để tắt.
BACKGROUND_JOBS=enabled
# Lưu tệp đính kèm: local (thư mục STORAGE_DIRECTORY, mặc định .storage) hoặc s3 (cần S3_BUCKET, AWS_REGION và quyền IAM).
STORAGE_DRIVER=local
STORAGE_DIRECTORY=
S3_BUCKET=
AWS_REGION=ap-southeast-1
# Kết nối GHN (CONG_VIEC_24): token, mã cửa hàng của tài khoản GHN; khóa webhook ít nhất 24 ký tự ngẫu nhiên, gắn vào đường dẫn webhook khai báo với GHN.
# GHN_BASE_URL để trống là môi trường thử nghiệm của GHN; môi trường thật: https://online-gateway.ghn.vn
GHN_API_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_KEY=
GHN_BASE_URL=
# Kết nối GHTK (CONG_VIEC_31): token API và mã đối tác (X-Client-Source) của tài khoản GHTK; khóa webhook ít nhất 24 ký tự ngẫu nhiên, gắn vào đường dẫn /public/carriers/ghtk/webhook/{khóa} khai báo với GHTK.
# Địa chỉ lấy hàng: tên, số điện thoại, địa chỉ, tỉnh, xã của kho xuất; mã địa chỉ lấy hàng trên GHTK không bắt buộc.
# GHTK_BASE_URL để trống là môi trường thử nghiệm của GHTK; môi trường thật: https://services.giaohangtietkiem.vn
GHTK_API_TOKEN=
GHTK_CLIENT_SOURCE=
GHTK_WEBHOOK_KEY=
GHTK_BASE_URL=
GHTK_PICK_ADDRESS_ID=
GHTK_PICK_NAME=
GHTK_PICK_TEL=
GHTK_PICK_ADDRESS=
GHTK_PICK_PROVINCE=
GHTK_PICK_WARD=
