{
  "expo": {
    "name": "VComm",
    "slug": "vcomm",
    "scheme": "vcomm",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "vn.vcomm.app",
      "supportsTablet": false
    },
    "android": {
      "package": "vn.vcomm.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "VComm cần dùng máy ảnh để quét mã QR tại cửa hàng liên kết.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VComm cần truy cập ảnh để bạn đính kèm ảnh khi yêu cầu trả hàng.",
          "cameraPermission": "VComm cần dùng máy ảnh để bạn chụp ảnh hàng khi yêu cầu trả hàng.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
