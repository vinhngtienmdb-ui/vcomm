{
  "expo": {
    "name": "VComm",
    "slug": "vcomm",
    "scheme": "vcomm",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "vn.vcomm.app",
      "supportsTablet": false
    },
    "android": {
      "package": "vn.vcomm.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
