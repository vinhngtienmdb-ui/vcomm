{
  "expo": {
    "name": "iPOS",
    "slug": "vcomm-ipos",
    "scheme": "vcommipos",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "android": {
      "package": "vn.vcomm.ipos",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
