{
  "expo": {
    "name": "VComm Kinh doanh",
    "slug": "vcomm-kinh-doanh",
    "scheme": "vcommkinhdoanh",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "bundleIdentifier": "vn.vcomm.kinhdoanh", "supportsTablet": false },
    "android": { "package": "vn.vcomm.kinhdoanh" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      ["expo-location", { "locationWhenInUsePermission": "VComm Kinh doanh dùng vị trí để ghi lượt ghé thăm khách." }],
      ["expo-image-picker", { "cameraPermission": "VComm Kinh doanh dùng máy ảnh để chụp ảnh lượt ghé thăm khách.", "photosPermission": false }]
    ]
  }
}
