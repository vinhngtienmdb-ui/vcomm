# Mẫu tệp .env của môi trường thật (CONG_VIEC_76, THAY_DOI_42). Sao chép thành /opt/vcomm/.env trên máy ảo, chmod 600.
# KHÔNG ghi giá trị thật vào kho mã. Dòng có "(bí mật)" chỉ người dùng tự nhập trên máy ảo.
# Danh sách, ý nghĩa: tài liệu 26 mục 1.3; .env.example ở gốc dự án.

# Phiên bản chạy (tag không có chữ v), do luồng triển khai đặt.
VCOMM_VERSION=
VCOMM_IMAGE_REPOSITORY=ghcr.io/vinhngtienmdb-ui

# Cloudflare Tunnel (bí mật): Cloudflare Zero Trust → Networks → Tunnels → token của tunnel vcomm-production.
CLOUDFLARE_TUNNEL_TOKEN=

# Cơ sở dữ liệu Supabase vcomm-production, Supavisor chế độ phiên cổng 5432 (bí mật).
# Dạng: postgresql://postgres.<mã dự án>:<mật khẩu>@aws-...pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/app/infra/certificates/supabase-ca.crt
DATABASE_URL=

# Khóa ứng dụng (bí mật): sinh ngẫu nhiên một lần (ít nhất 32 ký tự), không bao giờ sinh lại MFA_SECRET_KEY.
ACCESS_TOKEN_SECRET=
MFA_SECRET_KEY=

# Địa chỉ công khai.
WEB_ORIGIN=https://erp.vcomm.vn
SHARE_PUBLIC_URL=https://api.vcomm.vn
VCOMM_WEB_URL=https://app.vcomm.vn
APP_WEB_ORIGINS=https://app.vcomm.vn,https://kho.vcomm.vn,https://ipos.vcomm.vn
APP_STORE_URL=
GOOGLE_PLAY_URL=
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=

# Email qua hộp thư doanh nghiệp (CONG_VIEC_77).
EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
# (bí mật)
SMTP_PASSWORD=
SMTP_FROM=

# Lưu tệp Supabase Storage qua giao thức S3 (CONG_VIEC_79).
STORAGE_DRIVER=s3
S3_BUCKET=vcomm-tep
S3_ENDPOINT=https://xbtrauxpqmgqwjktcwqd.storage.supabase.co/storage/v1/s3
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=
AWS_REGION=ap-southeast-1
# (bí mật) Supabase → Storage → S3 access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cổng thanh toán VNPAY (bí mật: mã website, khóa).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=
VNPAY_RETURN_URL=https://api.vcomm.vn/api/v1/public/payments/vnpay/return

# Bộ giả lập tắt ở môi trường thật; trợ lý AI chưa bật.
LOYALTY_PARTNER_SIMULATOR=
AI_PROVIDER=
ANTHROPIC_API_KEY=
